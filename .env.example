# .env.example — llm-output-arbitration
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Runs in mock evaluation mode (CI-safe)
# SET to OpenAI key (sk-...): Live multi-agent adjudication with GPT-4o & critics
OPENAI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────
# UNSET: localhost:5432
# SET to PostgreSQL connection URL:
DATABASE_URL=
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=arbitration
DB_PORT=5432

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
